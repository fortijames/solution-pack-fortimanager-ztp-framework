        {
            "@type": "WorkflowStep",
            "name": "return_results",
            "description": null,
            "arguments": {
                "output": "{# Get execution results from task output #}\n{%- set exec_results = vars.steps.wait_for_task.output['script_data'] -%}\n\n{# Initialize results dictionary with execution data and default error state #}\n{%- set results = {\"script_data\": exec_results, \"error\": False} -%}\n\n{# Check non-zero status first (highest priority error indication) #}\n{%- if exec_results.status != 0 -%}\n  {%- do results.update({\n        \"error\": true,\n        \"msg\": \"Task execution failed with status code: \" + exec_results.status|string\n  }) -%}\n{# Check for \"error\" in response state #}\n{%- elif exec_results.get_response.state == \"error\" -%}\n  {%- do results.update({\n        \"error\": true,\n        \"msg\": exec_results.get_response.line[0].detail|default(\"Unknown error occurred\")\n  }) -%}\n{# Check for non-zero error count #}\n{%- elif exec_results.get_response.num_err > 0 -%}\n  {%- do results.update({\n        \"error\": true,\n        \"msg\": \"Execution completed with \" + exec_results.get_response.num_err|string + \" errors\"\n  }) -%}\n{# Check if any line has an error (err not equal to 0) #}\n{%- elif exec_results.get_response.line[0].err != 0 -%}\n  {%- do results.update({\n        \"error\": true,\n        \"msg\": \"Line execution error: \" + exec_results.get_response.line[0].detail|default(\"Error code: \" + exec_results.get_response.line[0].err|string)\n  }) -%}\n{# Check for error state in line #}\n{%- elif exec_results.get_response.line[0].state == \"error\" -%}\n  {%- do results.update({\n        \"error\": true,\n        \"msg\": exec_results.get_response.line[0].detail|default(\"Error in line execution\")\n  }) -%}\n{# Success case #}\n{%- else -%}\n  {# For success, get message from task response detail #}\n  {%- do results.update({\n        \"msg\": exec_results.get_response.line[0].detail|default(\"Task completed successfully\")\n  }) -%}\n  \n  {# Add execution time information to message for successful runs #}\n  {%- if vars.steps.wait_for_task.output.script_time is defined -%}\n    {%- do results.update({\n          \"execution_time\": vars.steps.wait_for_task.output.script_time.total_time\n    }) -%}\n  {%- endif -%}\n{%- endif -%}\n\n{# Extract helpful information from history if available #}\n{%- if exec_results.get_response.line[0].history is defined and results.error -%}\n  {# Find the last error entry in history #}\n  {%- set error_details = [] -%}\n  {%- for entry in exec_results.get_response.line[0].history -%}\n    {%- if entry.state == 5 or \"Error\" in entry.detail -%}\n      {%- do error_details.append(entry.detail) -%}\n    {%- endif -%}\n  {%- endfor -%}\n  \n  {# Add error history if found #}\n  {%- if error_details|length > 0 -%}\n    {%- do results.update({\"error_history\": error_details}) -%}\n  {%- endif -%}\n{%- endif -%}\n\n{# Output the final results dictionary #}\n{{ results }}",
                "params": "{{vars.input.params}}",
                "outtest": "{{vars.steps.wait_for_task}}"
            },
