            "@type": "WorkflowStep",
            "name": "create firmware base index",
            "description": null,
            "arguments": {
                "config": "74c7e349-a99d-44ac-a576-8c1b158fc364",
                "params": {
                    "python_function": "def parse_version(version_string):\r\n    # Extract major.minor from version string (e.g., \"6.0.4-b0231\" -> \"6.0\")\r\n    parts = version_string.split('.')\r\n    return f\"{parts[0]}.{parts[1]}\"\r\n\r\n\r\ndef create_platform_index(data):\r\n    # Initialize version mapping\r\n    version_platforms = {}\r\n\r\n    # Process each platform and its versions\r\n    for platform_data in data:\r\n        platform_name = platform_data['platform']\r\n        # Process each version for this platform\r\n        for version_info in platform_data['versions']:\r\n            base_version = parse_version(version_info['version'])\r\n            # Initialize the version entry if it doesn't exist\r\n            if base_version not in version_platforms:\r\n                version_platforms[base_version] = {\r\n                    \"platforms\": set()  # Use set to avoid duplicates\r\n                }\r\n            # Add the platform to this version's set\r\n            version_platforms[base_version][\"platforms\"].add(platform_name)\r\n\r\n    # Convert sets to sorted lists for JSON serialization\r\n    for version in version_platforms:\r\n        version_platforms[version][\"platforms\"] = sorted(list(version_platforms[version][\"platforms\"]))\r\n\r\n    # Sort by version number\r\n    return dict(sorted(version_platforms.items()))\r\n\r\n\r\n# Generate the index\r\nresult = create_platform_index({{vars.firmware_data}})\r\n\r\n\r\n# Print the formatted output\r\nprint(json.dumps(result, indent=2))"
                },
                "version": "2.1.3",
                "connector": "code-snippet",
                "operation": "python_inline_code_editor",
                "operationTitle": "Execute Python Code",
                "step_variables": []
            },
            "status": null,
            "top": "460",
