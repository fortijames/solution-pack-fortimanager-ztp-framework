            "name": "create managers",
            "description": null,
            "arguments": {
                "managers": "{%- set gtype = vars.steps.prompt_get_device_type.input.getDeviceType|lower -%}\n{%- set cfilter = vars.steps.prompt_get_device_type.input.customFilter -%}\n{%- set ret = '' -%}\n{%- set table = [] -%}\n\n{%- for m in vars.input.records -%}\n  {%- set r = {\"id\":m.id} -%}\n\n  {%- if \"custom\" in gtype -%}\n    {%- do r.update({\"filter\":cfilter}) -%}\n  {%- elif \"default\" in gtype -%}\n    {%- do r.update({\"filter\":m.newDeviceFilter|default('')}) -%}\n  {%- else -%}\n    {%- do r.update({\"filter\":gtype}) -%}\n  {%- endif -%}\n  \n  {%- do table.append(r) -%}\n\n{%- endfor -%}\n\n{{table}}"
            },
            "status": null,
            "top": "360",
            "left": "360",
