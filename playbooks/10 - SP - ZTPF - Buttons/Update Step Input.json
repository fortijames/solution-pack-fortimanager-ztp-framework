            "description": null,
            "arguments": {
                "step_input_yaml": "{%- set ret = {\n  \"yaml_form\":[],\n  \"devsteps\":{}\n} \n-%}\n\n{%- set steps = {} -%}\n{%- set step_recs = vars.input.records -%}\n{%- for r in step_recs| sort(attribute='ztpfDevices.name,stepNumber') -%}\n  {%- set d = r.ztpfDevices.name -%}\n  {%- if d not in steps -%}\n    {%- do steps.update({ d:{} }) -%}\n  {%- endif -%}\n  {%- do steps[d].update({\n          r.stepNumber:{\n            \"args\":r.stepARGS,\n            \"fqid\":r['@id'],\n            \"id\":r['id']\n          }\n        }) \n  -%}\n{%- endfor -%}\n\n{%- for d in steps -%}\n  {%- do ret.yaml_form.append(d + \":\") -%}\n  {%- for s in steps[d] %}  \n    {%- set st = \"  step\" + s|string %}\n    {%- do ret.yaml_form.append(st + \":\") -%}\n    {%- if d not in ret['devsteps'] -%}\n      {%- do ret['devsteps'].update({d:{}}) -%}\n    {%- endif -%}\n    {%- do ret['devsteps'][d].update({\n           st|trim:{ \n                \"fqid\":steps[d][s][\"fqid\"],\n                \"id\":steps[d][s][\"id\"] \n               }\n           }) \n    -%}\n   {%- set in = steps[d][s][\"args\"].split(\"\\n\") %}\n   {%- for i in in %}\n     {%- if i|trim != \"\" %}\n       {%- set i = \"    \" + i %}\n       {%- do ret.yaml_form.append(i) -%}\n      {%- endif %}\n    {%- endfor %}\n  {%- endfor %}\n{% endfor %}\n\n{{ret}}"
            },
            "status": null,
            "top": "40",
            "left": "340",
