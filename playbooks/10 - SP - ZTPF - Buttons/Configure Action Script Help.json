                            "field": "ztpfAutomationActions.id",
                            "value": "{{vars.input.records[0].id}}",
                            "operator": "eq",
                            "_operator": "eq"
                        },
                        {
                            "type": "primitive",
                            "field": "ztpfTemplates.id.uuid",
                            "value": "{{vars.steps.find_template|json_query('[].id')}}",
                            "operator": "in",
                            "_operator": "in"
                        }
                    ],
