        {
            "@type": "WorkflowStep",
            "name": "create example_data",
            "description": null,
            "arguments": {
                "example_data": "{%- set ret = {\"record\":{},\"data\":{}} -%}\n{%- if vars.input.records[0].exampleJinjaVars -%}\n  {%- do ret.update(vars.input.records[0].exampleJinjaVars) -%}\n{%- endif -%}\n   \n{%- for j in vars.steps.find_metadata_sources|json_query('[].exampleJinjaVars.record') -%}\n{%- do ret.record.update(j) -%}\n{%- endfor -%}\n\n{%- for m in vars.steps.find_metadata_sources|json_query('[].exampleOutput') -%}\n{%- do ret.data.update(m) -%}\n{%- endfor -%}\n\n{{ret}}"
            },
            "status": null,
            "top": "160",
            "left": "380",
            "stepType": "\/api\/3\/workflow_step_types\/04d0cf46-b6a8-42c4-8683-60a7eaa69e8f",
            "group": null,
            "uuid": "bbe31add-34d7-4788-aac7-6cca54b81dce"
        },
