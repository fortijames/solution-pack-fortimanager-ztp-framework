        {
            "@type": "WorkflowStep",
            "name": "create_post_data",
            "description": null,
            "arguments": {
                "post_data": "{\n  \"template\": '{{vars.input.params[\"script_template\"]|tojson}}', \n  \"values\": {{vars.input.params['script_vars']}}\n}"
            },
            "status": null,
            "top": "180",
            "left": "80",
