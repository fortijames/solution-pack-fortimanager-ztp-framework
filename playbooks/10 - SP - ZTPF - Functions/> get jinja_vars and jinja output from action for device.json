            "@type": "WorkflowStep",
            "name": "create jinja_vars",
            "description": "Extract jinja vars from the jinja_vars step that has data.",
            "arguments": {
                "jinja_vars": "{%- set ret = {} -%}\n\n{%- set ac = vars.steps.jinja_vars_from_action -%}\n{%- set tp = vars.steps.jinja_vars_from_template -%}\n\n{%- if tp.output.jinja_vars is defined -%}\n  {%- do ret.update(tp.output.jinja_vars) -%}\n  {%- do ret.update({\"template\":tp.output.script_rendered}) -%}  \n{%- endif -%}\n\n{%- if ac.output is defined -%}\n    {%- set merge =  ret | combine(ac.output) -%}\n    {%- do ret.update(merge) -%}\n{%- endif -%}  \n\n{{ret}}"
            },
            "status": null,
            "top": "580",
            "left": "660",
