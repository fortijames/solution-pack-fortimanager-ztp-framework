                "config": "74c7e349-a99d-44ac-a576-8c1b158fc364",
                "params": {
                    "python_function": "import json\r\n\r\ndef json_string_to_escaped_string(data, indent=2, sort_keys=False):\r\n    obj = json.loads(data)\r\n\r\n    pretty = json.dumps(\r\n        obj,\r\n        indent=indent,\r\n        sort_keys=sort_keys,\r\n        ensure_ascii=False\r\n    )\r\n\r\n    return (\r\n        pretty\r\n        .replace(\"\\\\\", \"\\\\\\\\\")\r\n        .replace('\"', '\\\\\"')\r\n        .replace(\"\\n\", \"\\\\n\")\r\n        .replace(\"{\", \"\\\\{\")\r\n        .replace(\"}\", \"\\\\}\")\r\n    )\r\n\r\ndata = '''\r\n{\r\n    \"name\": \"Alice\",\r\n    \"age\": 30,\r\n    \"groups\": [\"admin\", \"users\"],\r\n    \"active\": true\r\n}\r\n'''\r\n\r\nresult = json_string_to_escaped_string(data)\r\nprint(result)"
                },
