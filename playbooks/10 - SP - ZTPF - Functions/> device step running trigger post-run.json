            "description": null,
            "arguments": {
                "step_time": "{% macro human_time(total_seconds) -%}\n    {%- set total_seconds = total_seconds | int -%}\n    {%- set days = total_seconds \/\/ 86400 -%}\n    {%- set hours = (total_seconds % 86400) \/\/ 3600 -%}\n    {%- set minutes = (total_seconds % 3600) \/\/ 60 -%}\n    {%- set seconds = total_seconds % 60 -%}\n\n    {%- set out = [] -%}\n\n    {%- if days > 0 -%}\n        {%- set _ = out.append(days ~ \"d\") -%}\n    {%- endif -%}\n\n    {%- if hours > 0 -%}\n        {%- set _ = out.append(hours ~ \"h\") -%}\n    {%- endif -%}\n\n    {%- if minutes > 0 -%}\n        {%- set _ = out.append(minutes ~ \"m\") -%}\n    {%- endif -%}\n\n    {%- if total_seconds < 600 and seconds > 0 -%}\n        {%- set _ = out.append(seconds ~ \"s\") -%}\n    {%- endif -%}\n\n    {%- if out | length == 0 -%}\n        0s\n    {%- else -%}\n        {{ out | join(\" \") }}\n    {%- endif -%}\n{%- endmacro %}\n\n{%- set step_seconds = vars.steps.update_step_stop.stepStopTimestamp\n - vars.steps.update_step_stop.stepStartTimestamp -%}\n\n{%- set total_seconds = step_seconds -%}\n{{human_time(total_seconds )}}",
                "step_status": "{%- set ret = \"Complete\" -%}\n{%- if vars.steps.update_step_stop.outputSourceData.output.error or \"Fail\" in vars.current_status -%}\n{%- set ret = \"Fail\" -%}\n{%- endif -%}\n{{ret}}",
                "step_time_seconds": "{%- set step_seconds = vars.steps.update_step_stop.stepStopTimestamp\n - vars.steps.update_step_stop.stepStartTimestamp \n-%}\n\n{{step_seconds}}"
            },
            "status": null,
