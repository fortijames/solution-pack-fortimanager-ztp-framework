            "@type": "WorkflowStep",
            "name": "create device_data",
            "description": "Merge device record and api data.",
            "arguments": {
                "device_data": "{%- set api_query_results = vars.steps.query_device_source_data -%}\n{%- set find_device_records = vars.steps.find_device_records -%}\n\n{%- set table = [] -%}\n\n{%- for api in api_query_results -%}\n  {%- set concfg = api.params.connector_config -%}\n  {%- for dev in api.output.get_response -%}\n    {%- set sd = {\"record\":{},\"apidata\":{}} -%}\n    {%- set devname = dev.name -%}\n    {%- set recdata = find_device_records \n      | json_query('[?ztpfManagers.connectorConfig==`{}`]'\n          .format(concfg))\n      | json_query('[?name==`{}`]'\n          .format(devname))\n    -%}\n   {%- do sd.update({\"record\":recdata[0],\"apidata\":{\"dvmdb\":dev}}) -%}\n   {%- do table.append(sd) -%}    \n  {% endfor -%}\n{%- endfor -%}\n\n{{table}}"
            },
            "status": null,
            "top": "140",
            "left": "960",
            "stepType": "\/api\/3\/workflow_step_types\/04d0cf46-b6a8-42c4-8683-60a7eaa69e8f",
            "group": null,
            "uuid": "a4d551d6-71a3-4e56-8dd0-7556423a31bf"
        },
        {
