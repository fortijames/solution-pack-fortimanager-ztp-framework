            "@type": "WorkflowStep",
            "name": "setup query",
            "description": null,
            "arguments": {
                "api_queries": "{%- set fdev = vars.steps.find_device_records -%}\n{%- set idx = {} -%}\n{%- set table = [] -%}\n{%- for d in fdev -%}\n  {%- set cf = d.ztpfManagers.connectorConfig -%}\n  {%- set f = [\"name\",\"==\",d.name] -%}\n  {%- set cf = d.ztpfManagers.connectorConfig -%}\n\n  {%- if cf not in idx -%}\n    {%- do idx.update({cf:{\"connector_config\":cf,\"filter\":[]}}) -%}    \n  {%- endif -%}\n\n  {%- set updf = idx[cf].filter -%}\n  {%- if updf|length > 0 -%}\n    {%- do updf.append('||') -%}\n  {%- endif -%}\n  {%- do updf.append(f) -%}\n  {%- do idx[cf].update({\"filter\":updf}) -%}\n\n{%- endfor -%}\n\n{%- for m in idx -%}\n  {%- do table.append(idx[m]) -%}\n{%- endfor -%}\n{{table}}"
            },
            "status": null,
            "top": "120",
            "left": "660",
