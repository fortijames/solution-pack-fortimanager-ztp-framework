        {
            "@type": "WorkflowStep",
            "name": "create ztpfArtifacts",
            "description": null,
            "arguments": {
                "ztpfArtifacts": "{%- set artf = {\n  \"ztfGroup\":vars.ztpfGroup,\n  \"steps\":[]\n} -%}\n{%- set steps = vars.steps.find_steps -%}\n{%- for s in steps -%}\n  {%- set rec = {} -%}\n  {%- set act_id = s.ztpfAutomationActions.id -%}\n  {%- set act = vars.steps.find_actions\n      |json_query('[?id==`{}`]'.format(act_id)) \n  -%}\n  {%- do rec.update({\n    \"fqid\": s['@id'],\n    \"id\": s.id,\n    \"name\":s.name,\n    \"stepNumber\": s.stepNumber,\n    \"action_category\": act[0].category.itemValue,\n    \"action_type\": act[0].type.itemValue\n  }) -%}\n  {%- do artf.steps.append(rec) -%}\n{%- endfor -%}\n{{artf}}"
            },
            "status": null,
            "top": "360",
            "left": "660",
            "stepType": "\/api\/3\/workflow_step_types\/04d0cf46-b6a8-42c4-8683-60a7eaa69e8f",
            "group": null,
            "uuid": "6128e0b2-1ffb-481b-89eb-245af3ed3ed0"
        },
        {
