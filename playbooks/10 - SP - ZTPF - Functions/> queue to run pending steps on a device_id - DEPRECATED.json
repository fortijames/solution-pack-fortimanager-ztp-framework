            "arguments": {
                "query": {
                    "sort": [],
                    "limit": 30,
                    "logic": "AND",
                    "filters": [
                        {
                            "type": "primitive",
                            "field": "id",
                            "value": "{{vars.action_ids}}",
                            "operator": "in",
                            "_operator": "in"
                        }
                    ],
                    "__selectFields": [
                        "id",
                        "category",
                        "type"
                    ]
                },
                "module": "ztpf_automation_actions?$limit=5000",
                "checkboxFields": true,
                "step_variables": []
