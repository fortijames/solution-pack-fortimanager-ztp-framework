{
    "@type": "Workflow",
    "triggerLimit": null,
    "name": "> move step number on an automation profile",
    "aliasName": null,
    "tag": null,
    "description": "Use the profile_step_id to find the profile and all steps to then re-order the list as needed.",
    "isActive": true,
    "debug": false,
    "singleRecordExecution": false,
    "remoteExecutableFlag": false,
    "parameters": [
        "profile_step_id",
        "new_step_number"
    ],
    "synchronous": false,
    "collection": "\/api\/3\/workflow_collections\/517fb52d-36f5-4bac-a344-7d4599d7dec6",
    "versions": [],
    "triggerStep": "\/api\/3\/workflow_steps\/f87597af-bcf7-427c-9d12-f2c7e012ed2e",
    "steps": [
        {
            "@type": "WorkflowStep",
            "name": "find steps",
            "description": null,
            "arguments": {
                "when": "{{vars.steps.find_step_to_move[0].ztpfAutomationProfiles}}",
                "query": {
                    "sort": [
                        {
                            "field": "stepSequence",
                            "direction": "ASC",
                            "_fieldName": "stepSequence",
                            "_fieldTitle": "Step Number"
                        }
                    ],
                    "limit": 30,
                    "logic": "AND",
                    "filters": [
                        {
                            "type": "primitive",
                            "field": "ztpfAutomationProfiles",
                            "value": "{{vars.steps.find_step_to_move[0].ztpfAutomationProfiles['@id']}}",
                            "operator": "eq",
                            "_operator": "eq"
                        }
                    ],
                    "__selectFields": [
                        "stepSequence",
                        "id",
                        "name"
                    ]
                },
                "module": "ztpf_automation_profile_steps?$limit=5000",
                "checkboxFields": true,
                "step_variables": []
            },
            "status": null,
            "top": "40",
            "left": "640",
            "stepType": "\/api\/3\/workflow_step_types\/b593663d-7d13-40ce-a3a3-96dece928770",
            "group": null,
            "uuid": "8ee0bf1b-ff5a-420c-9dbd-38b342cedc33"
        },
        {
            "@type": "WorkflowStep",
            "name": "find step to move",
            "description": null,
            "arguments": {
                "query": {
                    "sort": [],
                    "limit": 30,
                    "logic": "AND",
                    "filters": [
                        {
                            "type": "primitive",
                            "field": "id",
                            "value": "{{vars.input.params['profile_step_id']}}",
                            "operator": "eq",
                            "_operator": "eq"
                        }
                    ]
                },
                "module": "ztpf_automation_profile_steps?$limit=1",
                "checkboxFields": true,
                "step_variables": []
            },
            "status": null,
            "top": "40",
            "left": "340",
            "stepType": "\/api\/3\/workflow_step_types\/b593663d-7d13-40ce-a3a3-96dece928770",
            "group": null,
            "uuid": "2b073cfe-ed18-48ea-bf8e-7aa5f9c39853"
        },
        {
            "@type": "WorkflowStep",
            "name": "invert step numbers",
            "description": "Invert step numbers to prevent unique constraints on the module.",
            "arguments": {
                "when": "{{vars.steps.find_steps}}",
                "for_each": {
                    "item": "{{vars.steps.find_steps}}",
                    "__bulk": true,
                    "parallel": false,
                    "condition": "",
                    "batch_size": 100
                },
                "resource": {
                    "stepSequence": "-{{vars.item.stepSequence}}"
                },
                "operation": "Append",
                "collection": "{{vars.item['@id']}}",
                "__recommend": [],
                "collectionType": "\/api\/3\/ztpf_automation_profile_steps",
                "fieldOperation": {
                    "recordTags": "Append"
                },
                "step_variables": []
            },
            "status": null,
            "top": "120",
            "left": "640",
            "stepType": "\/api\/3\/workflow_step_types\/b593663d-7d13-40ce-a3a3-96dece928722",
            "group": null,
            "uuid": "a4fde72e-80a2-47db-97be-0e9fb07ba403"
        },
        {
            "@type": "WorkflowStep",
            "name": "reordered_steps",
            "description": null,
            "arguments": {
                "reordered_steps": "{%- macro reorder_steps(steps, move_id, new_step) -%}\n  {%- set ordered = steps | sort(attribute='stepSequence') | list -%}\n  {%- set ns = namespace(item=None) -%}\n  {%- for s in ordered -%}\n      {%- if s.id == move_id -%}\n          {%- set ns.item = s -%}\n          {%- do ordered.remove(s) -%}\n          {%- break -%}\n      {%- endif -%}\n  {%- endfor -%}\n  {%- if ns.item -%}\n      {%- if new_step < 1 -%}\n          {%- set new_step = 1 -%}\n      {%- elif new_step > ordered | length + 1 -%}\n          {%- set new_step = ordered | length + 1 -%}\n      {%- endif -%}\n      {%- do ordered.insert(new_step - 1, ns.item) %}\n      {%- for s in ordered -%}\n          {%- do s.update({'stepSequence': loop.index}) -%}\n      {%- endfor -%}\n  {%- endif -%}\n  {{ ordered }}\n{%- endmacro -%}\n\n{%- set stepid = vars.steps.find_step_to_move[0].id -%}\n{%- set newstep = vars.input.params['new_step_number'] -%}\n{{ reorder_steps(vars.steps.find_steps, stepid, newstep) }}"
            },
            "status": null,
            "top": "200",
            "left": "640",
            "stepType": "\/api\/3\/workflow_step_types\/04d0cf46-b6a8-42c4-8683-60a7eaa69e8f",
            "group": null,
            "uuid": "e2c1be11-60db-4ff6-939d-86d4eb5a3b10"
        },
        {
            "@type": "WorkflowStep",
            "name": "return",
            "description": null,
            "arguments": {
                "output": "{{vars.steps.update_step_numbers}}",
                "params": "{{vars.input.params}}",
                "status": "{%- set status = {\"error\":true,\"msg\":\"No Steps Updated\"} -%}\n{%- if vars.steps.update_step_numbers|length > 0 -%}\n  {%- do status.update(\n      {\n        \"error\":false,\n        \"msg\": \"Updated \" \n                    + vars.steps.update_step_numbers|length|string \n                    + \" Steps.\"\n      }) \n  -%}\n{%- endif -%}\n{{status}}"
            },
            "status": null,
            "top": "280",
            "left": "40",
            "stepType": "\/api\/3\/workflow_step_types\/04d0cf46-b6a8-42c4-8683-60a7eaa69e8f",
            "group": null,
            "uuid": "511c1c13-bf02-4f68-a9f9-5e407221e4fa"
        },
        {
            "@type": "WorkflowStep",
            "name": "Start",
            "description": null,
            "arguments": {
                "__triggerLimit": true,
                "step_variables": {
                    "input": {
                        "params": []
                    }
                },
                "triggerOnSource": true,
                "triggerOnReplicate": false
            },
            "status": null,
            "top": "40",
            "left": "40",
            "stepType": "\/api\/3\/workflow_step_types\/b348f017-9a94-471f-87f8-ce88b6a7ad62",
            "group": null,
            "uuid": "f87597af-bcf7-427c-9d12-f2c7e012ed2e"
        },
        {
            "@type": "WorkflowStep",
            "name": "update step numbers",
            "description": null,
            "arguments": {
                "when": "{{vars.reordered_steps}}",
                "for_each": {
                    "item": "{{vars.reordered_steps}}",
                    "__bulk": true,
                    "parallel": false,
                    "condition": "",
                    "batch_size": 100
                },
                "resource": {
                    "stepSequence": "{{vars.item[\"stepSequence\"]}}"
                },
                "operation": "Append",
                "collection": "{{vars.item['@id']}}",
                "__recommend": [],
                "collectionType": "\/api\/3\/ztpf_automation_profile_steps",
                "fieldOperation": {
                    "recordTags": "Append"
                },
                "step_variables": []
            },
            "status": null,
            "top": "280",
