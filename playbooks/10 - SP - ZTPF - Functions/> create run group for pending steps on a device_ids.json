        {
            "@type": "WorkflowStep",
            "name": "create step_records",
            "description": null,
            "arguments": {
                "step_records": "{%- set artf = {\n  \"artifacts\" : {\n    \"ztfGroup\":vars.ztpfGroup,\n    \"ztfGroup_id\":vars.steps.create_run_group['id'],\n    \"ztfGroup_fqid\":vars.steps.create_run_group['@id']\n  },\n  \"steps\":[]\n} -%}\n\n{%- set steps = vars.steps.find_steps -%}\n{%- for s in steps -%}\n  {%- set rec = {} -%}\n  {%- set act_id = s.ztpfAutomationActions.id -%}\n  {%- set act = vars.steps.find_actions\n      |json_query('[?id==`{}`]'.format(act_id)) \n  -%}\n  {%- set dev = vars.steps.find_device\n      |json_query('[?id==`{}`]'.format(s.ztpfDevices.id)) \n  -%}\n  {%- do rec.update({\n    \"fqid\": s['@id'],\n    \"id\": s.id,\n    \"name\":s.name,\n    \"stepNumber\": s.stepNumber,\n    \"action_category\": act[0].category.itemValue,\n    \"action_type\": act[0].type.itemValue,\n    \"device_fqid\":dev[0]['@id'],\n    \"device_id\":dev[0].id,\n    \"device_name\":dev[0].name\n  }) -%}\n  {%- do artf.steps.append(rec) -%}\n{%- endfor -%}\n{{artf}}"
            },
