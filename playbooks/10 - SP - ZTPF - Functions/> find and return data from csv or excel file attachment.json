            "arguments": {
                "filter": "{{vars.input.params.filter}}",
                "filename": "{%- set inp = vars.input.params.filename -%}\n{%- if inp not in ['',None,Null] -%}\n{{inp}}\n{%- else -%}\n''\n{%- endif -%}",
                "filetags": "{%- set inp = vars.input.params.filetags -%}\n{%- if inp not in ['',None,Null] -%}\n{{inp.replace(' ',',').split(',')}}\n{%- else -%}\n[]\n{%- endif -%}",
                "file_fields": "[\"Name\",\"File\",\"Type\",\"ID\"]"
            },
            "status": null,
