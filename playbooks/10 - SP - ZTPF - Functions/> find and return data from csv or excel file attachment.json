                    "__selectFields": [
                        "id",
                        "name",
                        "file",
                        "type"
                    ]
                },
                "module": "attachments?$limit=5000",
                "checkboxFields": true,
                "step_variables": {
                    "find_files_results": "{{vars.steps.find_files}}"
                }
            },
            "status": null,
            "top": "100",
            "left": "960",
            "stepType": "\/api\/3\/workflow_step_types\/b593663d-7d13-40ce-a3a3-96dece928770",
