        },
        {
            "@type": "WorkflowStep",
            "name": "return",
            "description": null,
            "arguments": {
                "output": "{{vars.filtered_data}}",
                "params": "{{vars.input.params}}",
                "status": "{%- set files = vars.find_files_results | json_query('[].file.filename') -%}\n{%- set file_count = files|length -%}\n\n{%- set status = {\n  \"error\":false,\n  \"msg\": \"No errors seen searching \" + file_count|string + \" files: \" \n   + files|join(\", \")\n} -%}\n\n{%- if vars.filtered_data|length == 0 -%}\n{%- do status.update({\n  \"error\":true,\n  \"msg\": \"Nothing found searching files: \" + files|join(\", \")\n}) -%}\n{%- endif -%}\n\n{{status}}"
            },
            "status": null,
            "top": "120",
            "left": "40",
