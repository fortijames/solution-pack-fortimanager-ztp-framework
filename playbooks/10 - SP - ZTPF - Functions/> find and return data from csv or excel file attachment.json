                            "field": "createDate",
                            "direction": "ASC",
                            "_fieldName": "createDate",
                            "_fieldTitle": "Created On"
                        }
                    ],
                    "limit": 30,
                    "logic": "AND",
                    "filters": [
                        {
                            "type": "object",
                            "field": "type",
                            "value": "\/api\/3\/picklists\/9ad4871c-ef9a-4e44-a0e7-cc320041ad6f",
