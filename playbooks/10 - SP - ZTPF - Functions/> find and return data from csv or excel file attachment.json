        },
        {
            "@type": "WorkflowStep",
            "name": "filtered_data",
            "description": null,
            "arguments": {
                "filtered_data": "{% set final_dict = {} -%}\n{% set field = vars.filter.column -%}\n{% set param = vars.filter.value -%}\n{% set relevant_dictionaries = vars.file_data | json_query('[?{} ==`{}`]'.format(field,param)) -%}\n{% for item in relevant_dictionaries -%}\n\t{% do final_dict.update(item) -%}\n{% endfor -%}\n{{final_dict }}"
            },
            "status": null,
            "top": "460",
            "left": "600",
