    "steps": [
        {
            "@type": "WorkflowStep",
            "name": "find pending steps",
            "description": null,
            "arguments": {
                "when": "{{vars.steps.find_step_to_move[0].ztpfDevices}}",
                "query": {
                    "sort": [
                        {
                            "field": "stepNumber",
                            "direction": "ASC",
                            "_fieldName": "stepNumber",
                            "_fieldTitle": "Step Number"
                        }
                    ],
                    "limit": 30,
                    "logic": "AND",
                    "filters": [
                        {
                            "type": "object",
                            "field": "ztpfDevices",
                            "value": "{{vars.steps.find_step_to_move[0].ztpfDevices['@id']}}",
                            "_value": {
                                "@id": "{{vars.steps.find_step_to_move[0].ztpfDevices['@id']}}",
                                "display": "",
                                "itemValue": ""
                            },
                            "operator": "eq"
                        },
                        {
                            "type": "object",
                            "field": "ztpfRunGroups",
                            "value": "true",
                            "_value": {
                                "@id": "true",
                                "display": "",
                                "itemValue": ""
                            },
                            "operator": "isnull"
                        },
                        {
                            "type": "primitive",
                            "field": "stepDone",
                            "value": true,
                            "operator": "neq",
                            "_operator": "neq"
                        }
                    ],
                    "__selectFields": [
                        "id",
                        "stepNumber",
                        "name"
                    ]
                },
                "module": "ztpf_device_automation_steps?$limit=5000",
                "checkboxFields": true,
                "step_variables": []
            },
            "status": null,
            "top": "40",
            "left": "640",
            "stepType": "\/api\/3\/workflow_step_types\/b593663d-7d13-40ce-a3a3-96dece928770",
            "group": null,
            "uuid": "cf23fedf-02e8-4811-968e-5925e5ce291a"
        },
        {
            "@type": "WorkflowStep",
            "name": "find step to move",
            "description": null,
            "arguments": {
                "query": {
                    "sort": [],
                    "limit": 30,
                    "logic": "AND",
                    "filters": [
                        {
                            "type": "primitive",
                            "field": "id",
                            "value": "{{vars.input.params['device_step_id']}}",
                            "operator": "eq",
                            "_operator": "eq"
                        }
                    ],
                    "__selectFields": [
                        "id",
                        "ztpfDevices"
                    ]
                },
                "module": "ztpf_device_automation_steps?$limit=1",
                "checkboxFields": true,
                "step_variables": []
            },
            "status": null,
            "top": "40",
            "left": "340",
            "stepType": "\/api\/3\/workflow_step_types\/b593663d-7d13-40ce-a3a3-96dece928770",
            "group": null,
            "uuid": "1e852d1d-baf0-45ed-9bec-ea60b4873954"
        },
        {
            "@type": "WorkflowStep",
            "name": "invert step numbers",
            "description": "Invert step numbers to prevent unique constraints on the module.",
            "arguments": {
                "when": "{{vars.steps.find_pending_steps}}",
                "for_each": {
                    "item": "{{vars.steps.find_pending_steps}}",
                    "__bulk": true,
                    "parallel": false,
                    "condition": "",
                    "batch_size": 100
                },
                "resource": {
                    "stepNumber": "-{{vars.item.stepNumber}}"
                },
                "operation": "Append",
                "collection": "{{vars.item['@id']}}",
                "__recommend": [],
                "collectionType": "\/api\/3\/ztpf_device_automation_steps",
                "fieldOperation": {
                    "recordTags": "Append"
                },
                "step_variables": []
            },
            "status": null,
            "top": "120",
            "left": "640",
            "stepType": "\/api\/3\/workflow_step_types\/b593663d-7d13-40ce-a3a3-96dece928722",
            "group": null,
            "uuid": "2ba94945-b72d-46d0-a984-d27658560f83"
        },
        {
            "@type": "WorkflowStep",
            "name": "reordered_steps",
            "description": null,
            "arguments": {
                "reordered_steps": "{%- macro reorder_steps(steps, move_id, new_step) -%}\n  {%- set ordered = steps | sort(attribute='stepNumber') | list -%}\n  {%- set ns = namespace(item=None) -%}\n  {%- for s in ordered -%}\n      {%- if s.id == move_id -%}\n          {%- set ns.item = s -%}\n          {%- do ordered.remove(s) -%}\n          {%- break -%}\n      {%- endif -%}\n  {%- endfor -%}\n  {%- if ns.item -%}\n      {%- if new_step < 1 -%}\n          {%- set new_step = 1 -%}\n      {%- elif new_step > ordered | length + 1 -%}\n          {%- set new_step = ordered | length + 1 -%}\n      {%- endif -%}\n      {%- do ordered.insert(new_step - 1, ns.item) %}\n      {%- for s in ordered -%}\n          {%- do s.update({'stepNumber': loop.index}) -%}\n      {%- endfor -%}\n  {%- endif -%}\n  {{ ordered }}\n{%- endmacro -%}\n\n{%- set stepid = vars.steps.find_step_to_move[0].id -%}\n{%- set newstep = vars.input.params['new_step_number'] -%}\n{{ reorder_steps(vars.steps.find_pending_steps, stepid, newstep) }}"
            },
            "status": null,
            "top": "200",
            "left": "640",
            "stepType": "\/api\/3\/workflow_step_types\/04d0cf46-b6a8-42c4-8683-60a7eaa69e8f",
            "group": null,
            "uuid": "66455646-ff8d-40df-a5ae-db267fcd0e46"
        },
        {
            "@type": "WorkflowStep",
            "name": "return",
            "description": null,
            "arguments": {
                "output": "{{vars.steps.update_step_numbers}}",
                "params": "{{vars.input.params}}",
                "status": "{%- set status = {\"error\":true,\"msg\":\"No Steps Updated\"} -%}\n{%- if vars.steps.update_step_numbers|length > 0 -%}\n  {%- do status.update(\n      {\n        \"error\":false,\n        \"msg\": \"Updated \" \n                    + vars.steps.update_step_numbers|length|string \n                    + \" Steps.\"\n      }) \n  -%}\n{%- endif -%}\n{{status}}"
            },
            "status": null,
            "top": "280",
            "left": "40",
            "stepType": "\/api\/3\/workflow_step_types\/04d0cf46-b6a8-42c4-8683-60a7eaa69e8f",
            "group": null,
            "uuid": "0ad866aa-4edc-49a4-96e3-91f2805cc465"
