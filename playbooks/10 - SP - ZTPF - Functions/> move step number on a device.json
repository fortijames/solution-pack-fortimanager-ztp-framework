            "group": null,
            "uuid": "9a83c706-5dcd-47b5-98be-7673be6557ee"
        },
        {
            "@type": "WorkflowStep",
            "name": "update step numbers",
            "description": null,
            "arguments": {
                "for_each": {
                    "item": "{{vars.reordered_steps}}",
                    "__bulk": true,
                    "parallel": false,
                    "condition": "",
