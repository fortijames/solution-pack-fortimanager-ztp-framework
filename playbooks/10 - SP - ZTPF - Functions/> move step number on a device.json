{
    "@type": "Workflow",
    "triggerLimit": null,
    "name": "> move step number on a device",
    "aliasName": null,
    "tag": null,
    "description": "Use the device_step_id to find the device and all pending steps to then re-order the list as needed.",
    "isActive": true,
    "debug": false,
    "singleRecordExecution": false,
    "remoteExecutableFlag": false,
    "parameters": [
        "device_step_id",
        "new_step_number"
    ],
