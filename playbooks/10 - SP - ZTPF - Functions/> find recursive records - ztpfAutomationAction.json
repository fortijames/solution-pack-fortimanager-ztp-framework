                "checkboxFields": true,
                "step_variables": {
                    "type2record": "{%- set root = vars.steps.find_ztpfTemplate -%}\n{%- set ret = vars.type2record -%}\n\n{%- do ret.update({\"ztpfTemplate\":\n       root\n        | json_query('[].id')\n        | sort\n}) -%}\n\n{%- do ret.update({\"ztpfMetadataSource\":\n       ( ret.ztpfMetadataSource \n       + root\n        | json_query('[].ztpfMetadataSources')\n        | json_query('[].id')) | sort | unique\n        \n}) -%}\n\n{{ret}}"
                }
            },
            "status": null,
            "top": "220",
