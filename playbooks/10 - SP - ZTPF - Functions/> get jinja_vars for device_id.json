            "uuid": "6a900200-6dd9-4428-b49a-757da6810789"
        },
        {
            "@type": "WorkflowStep",
            "name": "jinja_vars for device metadata",
            "description": null,
            "arguments": {
                "jinja_vars_test": "{%- set ret = vars.jinja_vars -%}\n\n{%- for m in vars.steps.find_metadata -%}\n{%- set v = m.dataText or m.dataJSON -%}\n{%- do ret.record.metadata.update({\n  m.name:v\n}) -%}\n{%- endfor -%}\n{{ret}}"
            },
            "status": null,
            "top": "540",
