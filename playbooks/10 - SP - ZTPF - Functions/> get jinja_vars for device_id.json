        {
            "@type": "WorkflowStep",
            "name": "jinja_vars for device",
            "description": "Find vars matching record_dev_ and update jinja_vars.record.device.",
            "arguments": {
                "jinja_vars": "{%- set prefix = 'record_dev_' -%}\n{%- set ret = vars.jinja_vars -%}\n{%- for v in vars -%}\n  {%- if v.startswith(prefix) -%}\n    {%- set vp = v | regex_replace(prefix,'') -%}\n    {%- do ret.record.device.update({vp:vars[v]}) -%}\n  {%- endif -%}\n{%- endfor -%}\n{{ret}}"
            },
            "status": null,
            "top": "200",
            "left": "340",
            "stepType": "\/api\/3\/workflow_step_types\/04d0cf46-b6a8-42c4-8683-60a7eaa69e8f",
