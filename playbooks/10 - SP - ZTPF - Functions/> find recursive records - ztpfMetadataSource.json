            "arguments": {
                "type2record": "{%- set ret = vars.type2record -%}\n{%- set root = vars.steps.find_root_records -%}\n\n{%- do ret.update({\"ztpfMetadataSource\":\n       root\n        | json_query('[].id')\n        | sort\n}) -%}\n\n{%- do ret.update({\"ztpfAutomationAction\":\n       (ret.ztpfMetadataSource \n       + root\n        | json_query('[].ztpfAutomationActions')\n        | json_query('[].id')) | sort | unique\n}) -%}\n\n{%- do ret.update({\"ztpfTemplate\":\n       (ret.ztpfMetadataSource \n       + root\n        | json_query('[].ztpfTemplates')\n        | json_query('[].id')) | sort | unique\n}) -%}\n\n{{ret}}"
            },
            "status": null,
