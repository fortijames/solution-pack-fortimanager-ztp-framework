            "description": null,
            "arguments": {
                "text_data": "{%- macro filter_lines(text, include_regex=[], exclude_regex=[]) -%}\n    {%- set ns = namespace(lines=[], include=false, exclude=false) -%}\n\n    {%- for line in text.splitlines() -%}\n        {%- set ns.include = not include_regex -%}\n        {%- set ns.exclude = false -%}\n\n        {%- for pattern in include_regex -%}\n            {%- if line | regex_search(pattern) -%}\n                {%- set ns.include = true -%}\n            {%- endif -%}\n        {%- endfor -%}\n\n        {%- for pattern in exclude_regex -%}\n            {%- if line | regex_search(pattern) -%}\n                {%- set ns.exclude = true -%}\n            {%- endif -%}\n        {%- endfor -%}\n\n        {%- if ns.include and not ns.exclude -%}\n            {%- set ns.lines = ns.lines + [line] -%}\n        {%- endif -%}\n    {%- endfor -%}\n\n    {{- ns.lines | join('\\n') -}}\n{%- endmacro %}\n\n{%- set step_data = vars.steps.step_action.output.step_data_results -%}\n{%- set include = vars.steps.step_action.output.step_data_json.include_regex -%}\n{%- set exclude = vars.steps.step_action.output.step_data_json.exclude_regex -%}\n\n{%- if include in ['',None] -%}\n  {%- set include = [] -%}\n{%- endif -%}\n{%- if exclude in ['',None] -%}\n  {%- set exclude = [] -%}\n{%- endif -%}\n\n{%- set outp = {\n  \"text1\":\"\",\n  \"text2\":\"\"\n} -%}\n\n{%- if \"diffA\" in step_data -%}\n{%- do outp.update({\"text1\":filter_lines(\n    step_data.diffA,\n    include_regex=include,\n    exclude_regex=exclude\n  )}) -%}\n{%- endif -%}\n\n{%- if \"diffB\" in step_data  -%}\n{%- do outp.update({\"text2\":filter_lines(\n    step_data.diffB,\n    include_regex=include,\n    exclude_regex=exclude\n  )}) -%}\n{%- endif -%}\n\n{{outp}}"
            },
