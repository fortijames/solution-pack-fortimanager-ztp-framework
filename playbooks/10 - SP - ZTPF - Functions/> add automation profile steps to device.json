                "steps": "{%- set ret = [] -%}\n{%- set step = {\"id\":1} -%}\n{%- for r in vars.steps.find_profile_steps -%}\n  {%- set s = {} -%}\n  {%- do s.update({\n    \"action_fqid\": r.ztpfAutomationActions[\"@id\"],\n    \"step\": step.id,\n    \"name\":\"Step Test \" + step.id|string\n  }) -%}\n  {%- do ret.append(s) -%}\n  {%- do step.update({\"id\":step.id + 1}) -%}  \n{%- endfor -%}\n{{ret}}"
            },
            "status": null,
            "top": "360",
            "left": "340",
