        },
        {
            "@type": "WorkflowStep",
            "name": "create product_family",
            "description": null,
            "arguments": {
                "product_family": "{%- set platform = vars.platform  -%}\n\n{# Testing Platform Strings\n{%- set platform = 'FortiGate-81F' -%}\n{%- set platform = 'FortiGate-3601E' -%}\n{%- set platform = 'FortiGate-1101E' -%}\n{%- set platform = 'FortiWiFi-50G-DSL' -%}\n{%- set platform = 'FortiGate-602F' -%}\n{%- set platform = 'FortiGateRugged-70F-3G4G' -%}\n{%- set platform = 'FortiGate-VM64-ALI' -%}\n#}\n\n{%- set ret = '' -%}\n\n{%- set prefix_idx = {\n  \"fortigate\":\"FG\",\n  \"fortiwifi\":\"FWF\",\n  \"fortigaterugged\":\"FGR\"\n} -%}\n\n{%- set parts = platform.split('-') -%}\n{%- set prefix = parts[0]|lower -%}\n{%- set fam_number = parts[1]|regex_replace('[A-Z]','') -%}\n{%- set fam_letter = parts[1]|regex_replace('[0-9]','') -%}\n\n{%- if \"VM64\" in platform -%}\n  {%- set fam_base = \"\" -%}\n{%- elif fam_number|length == 2 -%}\n  {%- set fam_base = fam_number[0] + \"0\" -%}\n{%- elif fam_number|length == 3 -%}\n  {%- set fam_base = fam_number[0] + \"00\" -%}\n{%- elif fam_number|length == 4 -%}\n  {%- set fam_base = fam_number[0] + fam_number[1] + \"00\" -%}\n{%- else -%}\n  {%- set fam_base = fam_number -%}\n{%- endif -%}\n\n{%- if prefix in prefix_idx -%}\n  {%- set ret = prefix_idx[prefix] -%}\n{%- else -%}\n  {%- set ret = parts[0] -%}\n{%- endif -%}\n\n{%- if fam_number and fam_letter -%}\n  {%- set ret = ret \n        + ' ' + fam_base + fam_letter \n        + ' series' \n  -%}\n{%- endif -%}\n\n{{ret}}"
            },
            "status": null,
            "top": "280",
            "left": "380",
            "stepType": "\/api\/3\/workflow_step_types\/04d0cf46-b6a8-42c4-8683-60a7eaa69e8f",
            "group": null,
