            "@type": "WorkflowStep",
            "name": "create firmware",
            "description": null,
            "arguments": {
                "firmware": "{%- set ret = \n   vars.os_ver|int|string\n + \".\" + vars.mr|string\n + \".\" + vars.patch|string\n + \"-build\" + vars.build|string\n-%}\n\n{{ret}}"
