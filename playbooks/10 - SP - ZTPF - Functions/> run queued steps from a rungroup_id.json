        {
            "@type": "WorkflowStep",
            "name": "devices and ztpfArtifact",
            "description": "The ztpfArtifact data is deprecated. Might remove from this logic.",
            "arguments": {
                "device_records": "{%- set table = [] -%}\n{%- set devs = [] -%}\n\n{%- for d in vars.steps.find_steps|json_query('[].ztpfDevices') -%}\n{%- if d.id not in devs and ztpfRunning != True  -%}\n  {%- do devs.append(d.id) -%}\n  {%- set steps = [] -%}\n  {%- set steprecs = vars.steps.find_steps\n      |json_query('[?ztpfDevices.id==`{}`]'.format(d.id)) \n  -%}\n  {%- for s in steprecs -%}\n    {%- set act_id = s.ztpfAutomationActions.id -%}\n    {%- set act = vars.steps.find_actions\n        |json_query('[?id==`{}`]'.format(act_id)) \n    -%}\n    {%- set r = {\n          \"id\": s.id,\n          \"fqid\": s['@id'],\n          \"name\":s.name,\n          \"stepNumber\": s.stepNumber,\n          \"action_category\": act[0].category.itemValue,\n          \"action_type\": act[0].type.itemValue,\n          \"ztpf_status\":\"Pending\",\n          \"ztpf_start_time\":None,\n          \"ztpf_stop_time\":None\n        } \n    -%}\n    {%- do steps.append(r) -%}\n  {%- endfor -%}\n  {%- set r = {\n      \"id\":d.id,\n      \"fqid\":d[\"@id\"],\n      \"ztpfArtifact\": {\n        \"ztfGroup\": vars.steps.find_rungroup[0].name,\n        \"total_steps\":steps|length,\n        \"steps\": steps\n      }\n    } \n  -%}\n  {%- do table.append(r) -%}\n{%- endif -%}\n{%- endfor -%}\n{{table}}"
            },
            "status": null,
            "top": "360",
