        },
        {
            "@type": "WorkflowStep",
            "name": "new_metadata",
            "description": null,
            "arguments": {
                "new_metadata": "{%- set ret = [] -%}\n\n{%- set md = vars.input.params.metadata_input -%}\n{%- set existing_mds  = vars.steps.find_metadata -%}\n{%- set existing_md_names = existing_mds|json_query('[].name') -%}\n\n{%- for m in md -%}\n  {%- if m not in existing_md_names -%}\n    {%- if md[m] is string -%}\n      {%- do ret.append({\"type\":\"Text\",\"name\":m,\"value\":md[m]}) -%}\n    {%- else -%}\n      {%- do ret.append({\"type\":\"JSON\",\"name\":m,\"value\":md[m]}) -%}\n    {%- endif -%}\n  {%- endif -%}\n{%- endfor -%}\n\n{{ret}}"
            },
            "status": null,
            "top": "280",
            "left": "540",
            "stepType": "\/api\/3\/workflow_step_types\/04d0cf46-b6a8-42c4-8683-60a7eaa69e8f",
            "group": null,
            "uuid": "af022c07-b992-46fd-9461-3acbeb37550b"
        },
        {
            "@type": "WorkflowStep",
            "name": "return",
            "description": null,
            "arguments": {
                "output": "{%- set ret = {\"updated\":{},\"created\":{}} -%}\n\n{%- if vars.new_metadata|length > 0 -%}\n{%- do ret.update({\"created\":vars.steps.create_metadata }) -%}\n{%- endif -%}\n\n{%- if vars.update_metadata|length > 0 -%}\n{%- do ret.update({\"updated\":vars.steps.update_metadata}) -%}\n{%- endif -%}\n\n{{ret}}",
                "params": "{{vars.input.params}}",
                "status": "{\n  \"status\": {\n    \"msg\": \"Metadata should be done.\",\n    \"error\": false\n  }\n}"
            },
            "status": null,
            "top": "480",
