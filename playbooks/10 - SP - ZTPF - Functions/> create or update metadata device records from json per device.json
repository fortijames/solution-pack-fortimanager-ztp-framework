        {
            "@type": "WorkflowStep",
            "name": "find device",
            "description": null,
            "arguments": {
                "query": {
                    "sort": [],
                    "limit": 30,
                    "logic": "AND",
                    "filters": [
                        {
                            "type": "primitive",
                            "field": "id",
                            "value": "{{vars.input.params['device_id']}}",
                            "operator": "eq",
                            "_operator": "eq"
                        }
                    ],
                    "__selectFields": [
                        "id"
                    ]
                },
                "module": "ztpf_devices?$limit=1",
                "checkboxFields": true,
                "step_variables": []
            },
            "status": null,
            "top": "80",
