        {
            "@type": "WorkflowStep",
            "name": "create metadata",
            "description": null,
            "arguments": {
                "when": "{{vars.new_metadata|length > 0}}",
                "for_each": {
                    "item": "{{vars.new_metadata}}",
                    "__bulk": true,
                    "parallel": false,
                    "condition": "",
                    "batch_size": 100
                },
                "resource": {
                    "name": "{{vars.item.name}}",
                    "type": "{{\"ztpfMetadataType\" | picklist(vars.item.type, \"@id\")}}",
                    "status": "\/api\/3\/picklists\/589e0a44-3aa9-4e49-ae62-e28199344659",
                    "dataJSON": "{%- if vars.item.type == \"JSON\" -%}{{vars.item.value}}{%- endif -%}",
                    "dataText": "{%- if vars.item.type == \"Text\" -%}{{vars.item.value}}{%- endif -%}",
                    "__replace": "",
                    "ztpfDevices": "{{vars.steps.find_device[0]['@id']}}"
                },
                "operation": "Overwrite",
                "collection": "\/api\/3\/ztpf_metadata_devices",
                "__recommend": [],
                "fieldOperation": {
                    "recordTags": "Overwrite"
                },
                "step_variables": []
            },
            "status": null,
            "top": "360",
