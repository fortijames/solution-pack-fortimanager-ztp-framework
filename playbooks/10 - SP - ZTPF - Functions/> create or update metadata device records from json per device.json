        {
            "@type": "WorkflowStep",
            "name": "find metadata",
            "description": null,
            "arguments": {
                "query": {
                    "sort": [],
                    "limit": 30,
                    "logic": "AND",
                    "filters": [
                        {
                            "type": "object",
                            "field": "ztpfDevices",
                            "value": "{{vars.steps.find_device[0]['@id']}}",
                            "_value": {
                                "@id": "{{vars.steps.find_device[0]['@id']}}",
                                "display": "",
                                "itemValue": ""
                            },
                            "operator": "eq"
                        }
                    ],
                    "__selectFields": [
                        "id",
                        "name",
                        "type"
                    ]
                },
                "module": "ztpf_metadata_devices?$limit=5000",
                "checkboxFields": true,
                "step_variables": []
