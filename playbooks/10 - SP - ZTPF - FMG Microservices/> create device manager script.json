            "uuid": "6dda7e80-291f-4a92-8798-9358cf3a1bde"
        },
        {
            "@type": "WorkflowStep",
            "name": "get fmg version matrix",
            "description": null,
            "arguments": {
                "when": "{{vars.input.params['fmg_version']}}",
                "arguments": {
                    "version": "{{vars.input.params['fmg_version']}}",
                    "find_version_list": "[\n\"<= 7.6.4\"\n]"
                },
                "apply_async": false,
                "step_variables": {
                    "fmg_legacyversion_scripts_check": "{{vars.steps.get_fmg_version_matrix.output['version_check']}}"
                },
                "pass_parent_env": false,
                "pass_input_record": false,
                "workflowReference": "\/api\/3\/workflows\/99a05d7e-1a17-4375-b475-b315e14cdd1f"
            },
            "status": null,
