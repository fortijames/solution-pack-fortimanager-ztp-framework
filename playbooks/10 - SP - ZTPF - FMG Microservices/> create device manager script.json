            "group": null,
            "uuid": "220add5b-2ffe-4820-a850-41db027246df"
        },
        {
            "@type": "WorkflowStep",
            "name": "return",
            "description": null,
            "arguments": {
                "output": "{{vars.steps.create_script}}",
                "params": "{{vars.input.params}}",
                "status": "{%- set stat = vars.status -%}\n\n{%- set res = vars.steps.create_script.data -%}\n{%- if res.status != 0 -%}\n  {%- do stat.update({\n    \"error\":true,\n    \"message\": res.add_response.status.message\n  }) -%}\n{%- endif -%}\n\n{{stat}}"
            },
            "status": null,
            "top": "120",
            "left": "40",
            "stepType": "\/api\/3\/workflow_step_types\/04d0cf46-b6a8-42c4-8683-60a7eaa69e8f",
            "group": null,
            "uuid": "7ddda12f-a034-458b-83df-629cbc834080"
        },
        {
            "@type": "WorkflowStep",
            "name": "setup payload and url",
            "description": null,
            "arguments": {
                "url": "{# \n# matches legacy version use \/dvmdb\/adom\/<adom>\/script\/\n#  default to \/pm\/config\/adom\/<adom>\/obj\/fmg\/script\n#}\n{%- if true in vars.fmg_legacyversion_scripts_check.values() | list -%}\n\/dvmdb\/adom\/{{vars.input.params.adom}}\/script\/\n{%- else -%}\n\/pm\/config\/adom\/{{vars.input.params.adom}}\/obj\/fmg\/script\n{%- endif -%}",
                "script_payload": "{%- set script_type = vars.script_type -%}\n\n{%- set payload = {} -%}\n{%- set tgt = vars.script_type_ref[script_type].target -%}\n{%- set typ =  vars.script_type_ref[script_type].type -%}\n\n{%- set _do = payload.update({\n    \"data\": {\n      \"name\":vars.script_name,\n      \"target\":tgt,\n      \"type\":typ,\n      \"content\":vars.script_contents.strip('\\\"'),\n      \"desc\": \"Created by FortiSOAR and will be deleted when executed.\"\n    }\n  }) \n%}\n{{payload}}"
            },
            "status": null,
            "top": "380",
            "left": "760",
            "stepType": "\/api\/3\/workflow_step_types\/04d0cf46-b6a8-42c4-8683-60a7eaa69e8f",
            "group": null,
            "uuid": "b7a3806d-1cb7-483c-9a44-5ead6e232122"
        },
        {
            "@type": "WorkflowStep",
            "name": "setup vars data",
            "description": null,
            "arguments": {
                "status": "{# Set a default status #}\n{%- set ret = {} -%}\n{%- do ret.update({\n  \"error\":false,\n  \"message\":\"\"\n}) -%}\n{{ret}}",
                "script_name": "{{vars.input.params['script_name']}}",
                "script_type": "{{vars.input.params['script_type']}}",
                "script_contents": "{{vars.input.params['script_contents']}}",
                "script_type_ref": "{%- set script_type_input = vars.input.params.script_type -%}\n{%- set target_type = {} -%}\n\n{# \n# matches legacy version create legacy script ref\n#  default to current options\n#}\n{%- set legacy = false -%}\n{%- if true in vars.fmg_legacyversion_scripts_check.values() | list -%}\n  {%- set legacy = true -%}\n{%- endif -%}\n\n{%- if legacy -%}\n  {%- do target_type.update({\n    \"DeviceDB\":{\"target\": \"device_database\",\"type\": \"cli\"},\n    \"Remote CLI\":{\"target\": \"remote_device\",\"type\": \"cli\"},\n    \"Remote TCL\":{\"target\": \"remote_device\",\"type\": \"tcl\"},\n    \"PolicyDB\":{\"target\": \"adom_database\",\"type\": \"cli\"}\n    }) -%}\n{%- else -%}\n  {%- do target_type.update({\n    \"DeviceDB\":{\"target\": \"devdb\",\"type\": \"cli\"},\n    \"Remote CLI\":{\"target\": \"remote\",\"type\": \"cli\"},\n    \"Remote TCL\":{\"target\": \"remote\",\"type\": \"tcl\"},\n    \"PolicyDB\":{\"target\": \"adomdb\",\"type\": \"cli\"}\n    }) -%}\n{%- endif -%}\n\n{{target_type}}",
                "connector_config": "{{vars.input.params['connector_config']}}"
            },
            "status": null,
            "top": "120",
            "left": "760",
            "stepType": "\/api\/3\/workflow_step_types\/04d0cf46-b6a8-42c4-8683-60a7eaa69e8f",
            "group": null,
            "uuid": "db43be2f-4172-41f6-a7be-b3b57df228e4"
        },
