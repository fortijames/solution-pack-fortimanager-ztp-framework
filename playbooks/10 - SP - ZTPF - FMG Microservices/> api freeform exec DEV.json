            "description": null,
            "arguments": {
                "output": "{{vars.steps.fmg_api}}",
                "params": "{{vars.input.params}}",
                "status": "{%- set s = vars.return_status -%}\n{%- do s.update({\"message\": \"API Looks ok\"}) -%}\n{%- set fmgret = vars.steps.fmg_api.data -%}\n\n{%- if fmgret.status is defined and fmgret.status.code is defined and fmgret.status.code != 0 -%}\n  {%- do s.update({\n    \"error\": true,\n    \"message\": \"proxy call failed: \" + (fmgret.status.message | default('unknown error', true))\n  }) -%}\n{%- endif -%}\n\n{%- if fmgret.execute_response is defined and fmgret.execute_response[0] is defined\n      and fmgret.execute_response[0].status is defined\n      and fmgret.execute_response[0].status.code != 0\n-%}\n  {%- do s.update({\n    \"error\": true,\n    \"message\": \"device call failed: \" + (fmgret.execute_response[0].status.message | default('unknown error', true))\n  }) -%}\n{%- endif -%}\n\n{{s}}"
            },
