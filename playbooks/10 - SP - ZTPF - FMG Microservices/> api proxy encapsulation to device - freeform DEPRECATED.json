        },
        {
            "@type": "WorkflowStep",
            "name": "initial vars",
            "description": null,
            "arguments": {
                "in_action": "{{vars.input.params.action}}",
                "in_target": "{%- set in_field = vars.input.params.target -%}\n{%- set ret = '' -%}\n\n{%- if in_field not in ['',None] -%}\n  {%- if in_field is sequence and in_field is not string -%}\n    {% set ret = in_field %}\n  {%- else -%}\n    {%- set cmt = in_field | regex_replace('[,\\n]+', ',') -%}\n    {%- set ret = cmt.split(',') | list -%}\n  {%- endif -%}\n{%- endif -%}\n\n{{ret}}",
                "in_payload": "{{vars.input.params.payload}}",
                "in_resource": "{{vars.input.params.resource}}",
                "return_status": "{{globalVars.ztpf_return_status_default}}",
                "api_json_proxy": "\/sys\/proxy\/json",
                "connector_config": "{{vars.input.params['connector_config']}}"
            },
            "status": null,
            "top": "40",
            "left": "340",
            "stepType": "\/api\/3\/workflow_step_types\/04d0cf46-b6a8-42c4-8683-60a7eaa69e8f",
