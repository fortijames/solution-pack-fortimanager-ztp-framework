                "config": "{{vars.connector_config}}",
                "params": {
                    "data": "{{vars.api_payload}}",
                    "method": "exec"
                },
                "version": "1.1.0",
                "connector": "fortinet-fortimanager-json-rpc",
                "operation": "json_rpc_freeform",
                "operationTitle": "JSON RPC Freeform",
