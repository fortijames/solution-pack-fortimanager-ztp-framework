            "@type": "WorkflowStep",
            "name": "api variables",
            "description": null,
            "arguments": {
                "api_url": "\/pm\/config\/adom\/{{vars.adom}}\/_data\/dvm\/device\/model",
                "api_data": "[\n    {\n      \"data\": {\n        \"flags\": 1,\n        \"product\": \"FGT\"\n      },\n      \"url\": \"\/um\/image\/version\/list\"\n    }\n]"
            },
            "status": null,
            "top": "160",
            "left": "740",
            "stepType": "\/api\/3\/workflow_step_types\/04d0cf46-b6a8-42c4-8683-60a7eaa69e8f",
