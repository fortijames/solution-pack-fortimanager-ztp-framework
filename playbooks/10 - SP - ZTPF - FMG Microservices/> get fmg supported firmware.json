        },
        {
            "@type": "WorkflowStep",
            "name": "create firmware base index",
            "description": null,
            "arguments": {
                "config": "74c7e349-a99d-44ac-a576-8c1b158fc364",
                "params": {
                    "python_function": "import json\r\n\r\n\r\ndef parse_version(version_string):\r\n    # Extract major.minor from version string (e.g., \"6.0.4-b0231\" -> \"6.0\")\r\n    parts = version_string.split('.')\r\n    return f\"{parts[0]}.{parts[1]}\"\r\n\r\n\r\ndef create_platform_index(data):\r\n    # Initialize version mapping\r\n    version_platforms = {}\r\n\r\n    # Process each platform and its versions\r\n    for platform_data in data:\r\n        platform_name = platform_data['platform']\r\n        # Process each version for this platform\r\n        for version_info in platform_data['versions']:\r\n            base_version = parse_version(version_info['version'])\r\n            # Initialize the version entry if it doesn't exist\r\n            if base_version not in version_platforms:\r\n                version_platforms[base_version] = {\r\n                    \"platforms\": []\r\n                }\r\n            # Add the platform if it's not already in the list\r\n            if platform_name not in version_platforms[base_version][\"platforms\"]:\r\n                version_platforms[base_version][\"platforms\"].append(platform_name)\r\n\r\n    # Sort platform lists\r\n    for version in version_platforms:\r\n        version_platforms[version][\"platforms\"].sort()\r\n\r\n    # Sort by version number\r\n    return dict(sorted(version_platforms.items()))\r\n\r\n\r\n# Generate the index\r\nresult = create_platform_index({{vars.firmware_data}})\r\nprint(json.dumps(result, indent=2))"
                },
                "version": "2.1.4",
                "connector": "code-snippet",
                "operation": "python_inline_code_editor",
                "operationTitle": "Execute Python Code",
                "step_variables": []
            },
            "status": null,
            "top": "460",
            "left": "380",
            "stepType": "\/api\/3\/workflow_step_types\/1fdd14cc-d6b4-4335-a3af-ab49c8ed2fd8",
            "group": null,
            "uuid": "4826af0b-7bdf-4c67-98cf-7a354bb89384"
        },
