        },
        {
            "@type": "WorkflowStep",
            "name": "setup vars",
            "description": null,
            "arguments": {
                "api_url": "\/task\/task",
                "api_fields": "{%- set in_field = vars.input.params['fields'] -%}\n{%- set ret = '' -%}\n\n{%- if in_field not in ['',None] -%}\n  {%- if in_field is sequence and in_field is not string -%}\n    {% set ret = in_field %}\n  {%- else -%}\n    {%- set cmt = in_field | regex_replace('[,\\n]+', ',') -%}\n    {%- set ret = cmt.split(',') | list -%}\n  {%- endif -%}\n{%- endif -%}\n\n{{ret}}",
                "api_filter": "{%- set inf = vars.input.params['filter'] -%}\n{%- set kws = vars.filter_db.keys() | list -%}\n\n{%- if inf|lower in ['',None,\"all\"] -%}\n  {%- set inf = vars.filter_db[\"default\"] -%}\n{%- elif inf|lower in kws -%}\n  {%- set inf = vars.filter_db[inf|lower] -%}\n{%- endif -%}\n\n{{inf}}",
                "return_status": "{{globalVars.ztpf_return_status_default}}",
                "connector_config": "{{vars.input.params['connector_config']}}"
            },
            "status": null,
            "top": "40",
