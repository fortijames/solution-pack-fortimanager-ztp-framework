                "config": "{{vars.input.params['connector_config']}}",
                "params": {
                    "data": "{{vars.api_data}}",
                    "method": "get"
                },
                "version": "1.1.0",
                "connector": "fortinet-fortimanager-json-rpc",
                "operation": "json_rpc_freeform",
