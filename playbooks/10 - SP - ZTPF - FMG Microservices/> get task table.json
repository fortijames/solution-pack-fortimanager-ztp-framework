        },
        {
            "@type": "WorkflowStep",
            "name": "return",
            "description": null,
            "arguments": {
                "output": "{{vars.steps.get_tasks.data['free_form_response'][0].data}}",
                "params": "{{vars.input.params}}",
                "status": "{%- set ret = vars.return_status -%}\n{%- set step_data = vars.steps.get_tasks -%}\n\n{%- if step_data.status != \"Success\" -%}\n  {%- do ret.update({\n    \"error\": True,\n    \"message\": \"Status Fail (\" + step_data.status + \")\"\n  }) -%}\n{%- else -%}\n  {%- do ret.update({\n    \"message\": \"FMG API Successful\"\n  }) -%}\n{%- endif -%}\n{{ret}}"
            },
            "status": null,
