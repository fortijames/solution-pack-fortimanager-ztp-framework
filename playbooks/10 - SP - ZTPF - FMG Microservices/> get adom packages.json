        },
        {
            "@type": "WorkflowStep",
            "name": "return",
            "description": null,
            "arguments": {
                "output": "{{vars.steps.fmg_api.data}}",
                "params": "{{vars.input.params}}",
                "status": "{%- set stat = vars.status -%}\n{%- set ret = vars.steps.fmg_api -%}\n\n{%- if ret.data.status != 0 -%}\n  {%- do stat.update({\n    \"error\":true,\n  }) -%}\n  {%- if ret.data.get_response.status.message is defined -%}\n    {%- do stat.update({\n      \"message\": ret.data.get_response.status.message\n    }) -%}\n  {%- endif -%}\n{%- endif -%}\n\n{{stat}}"
            },
            "status": null,
            "top": "120",
            "left": "40",
            "stepType": "\/api\/3\/workflow_step_types\/04d0cf46-b6a8-42c4-8683-60a7eaa69e8f",
