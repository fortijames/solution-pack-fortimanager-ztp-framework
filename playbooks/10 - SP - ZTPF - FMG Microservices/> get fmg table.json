                "api_data": "{%- set apiopts = vars.api_options -%}\n{%- set apifilter = vars.api_filter -%}\n{%- set apifields = vars.api_fields -%}\n\n{%- set ret = {\n  \"loadsub\":vars.api_loadsub\n} -%}\n\n\n{%- if apiopts -%}\n{%- do ret.update({\"options\":apifilter}) -%}\n{%- endif -%}\n\n{%- if apifilter -%}\n{%- do ret.update({\"filter\":apifilter}) -%}\n{%- endif -%}\n\n{%- if apifields -%}\n{%- do ret.update({\"fields\":apifields}) -%}\n{%- endif -%}\n\n{{ret}}",
                "connector_config": "{{vars.input.params['connector_config']}}"
