            "uuid": "6c13dc6c-a095-4a3b-b368-7487dd67721e"
        },
        {
            "@type": "WorkflowStep",
            "name": "exec_payload",
            "description": null,
            "arguments": {
                "api_url": "\/dvmdb\/adom\/{{vars.adom}}\/script\/execute",
                "data_payload": "{\n  \"data\": {    \n    \"adom\": \"{{vars.adom}}\", \n    \"script\": \"{{vars.script_name}}\", \n    \"scope\": {{vars.device_scope}}\n  }\n}"
            },
            "status": null,
            "top": "240",
