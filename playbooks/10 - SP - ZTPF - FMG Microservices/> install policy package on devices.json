        },
        {
            "@type": "WorkflowStep",
            "name": "exec_payload",
            "description": null,
            "arguments": {
                "api_payload": "{%- set data = {\n    \"adom\": vars.input.params.adom,\n    \"flags\": [\"auto_lock_ws\"],\n    \"pkg\": vars.package,\n    \"scope\": vars.device_scope\n  }\n-%}\n\n{%- if vars.flags -%}\n  {%- set f = data.flags -%}\n  {%- do data.update({\"flags\":(f + vars.flags)|unique}) -%}\n{%- endif -%}\n\n{\n  \"data\":{{data}}\n}"
            },
            "status": null,
            "top": "360",
