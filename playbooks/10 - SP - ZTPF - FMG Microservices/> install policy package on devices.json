            "@type": "WorkflowStep",
            "name": "compare scope",
            "description": null,
            "arguments": {
                "scope_ok": "{%- set list1 = vars.device_scope -%}\n{%- set list2 = vars.steps.get_or_create_pkg.output['scope member'] -%}\n\n{% set all_exist = \n  list1\n  | select('in', list2) \n  | list \n  | length == list1 \n  | length \n%}\n\n{{ all_exist }}"
            },
            "status": null,
            "top": "200",
            "left": "800",
            "stepType": "\/api\/3\/workflow_step_types\/04d0cf46-b6a8-42c4-8683-60a7eaa69e8f",
