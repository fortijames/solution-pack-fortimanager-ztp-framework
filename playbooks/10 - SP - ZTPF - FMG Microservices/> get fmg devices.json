    "triggerStep": "\/api\/3\/workflow_steps\/e831f29c-c6ce-4fff-b2ad-836f2c34140b",
    "steps": [
        {
            "@type": "WorkflowStep",
            "name": "create filter_db",
            "description": "Setup a reference of redefined functions.",
            "arguments": {
                "filter_db": "{\n\"default\": [\"os_type\",\"==\",\"fos\"],\n\"unauthorized\" : [[\"mgmt_mode\",\"==\",0],\"&&\",[\"os_type\",\"==\",\"fos\"]],\n\"authorized\" : [[\"mgmt_mode\",\"==\",1],\"&&\",[\"os_type\",\"==\",\"fos\"]],\n\"model\" : [[\"conn_status\",\"==\",\"UNKNOWN\"],\"&&\",[\"os_type\",\"==\",\"fos\"]],\n\"real\" : [[\"conn_status\",\"!=\",\"UNKNOWN\"],\"&&\",[\"os_type\",\"==\",\"fos\"]]\n}"
            },
            "status": null,
            "top": "40",
            "left": "360",
            "stepType": "\/api\/3\/workflow_step_types\/04d0cf46-b6a8-42c4-8683-60a7eaa69e8f",
            "group": null,
            "uuid": "7285bc70-aa52-4d43-9499-a1900c344af4"
        },
        {
            "@type": "WorkflowStep",
            "name": "fmg_api",
            "description": null,
            "arguments": {
                "name": "Fortinet FortiManager JSON RPC",
                "when": "{{vars.connector_config}}",
                "config": "{{vars.connector_config}}",
                "params": {
                    "url": "{{vars.api_url}}",
                    "data": "{{vars.api_data}}"
                },
                "version": "1.1.0",
                "connector": "fortinet-fortimanager-json-rpc",
                "operation": "json_rpc_get",
                "operationTitle": "JSON RPC Get",
                "pickFromTenant": false,
                "step_variables": []
            },
            "status": null,
            "top": "280",
            "left": "360",
            "stepType": "\/api\/3\/workflow_step_types\/0bfed618-0316-11e7-93ae-92361f002671",
            "group": null,
            "uuid": "46b4edd7-cf99-4b3b-9d5f-d84a926259b6"
        },
        {
            "@type": "WorkflowStep",
            "name": "handle inputs",
            "description": "overwrite the inputs if needed.",
            "arguments": {
                "api_url": "{%- if vars.input.params['api_adom'] not in ['',None] -%}\n\/dvmdb\/adom\/{{vars.input.params['api_adom']}}\/device\n{%- else -%}\n\/dvmdb\/device\n{%- endif -%}",
                "api_fields": "{{vars.input.params['api_fields']}}",
                "api_filter": "{%- set inf = vars.input.params['api_filter'] -%}\n{%- set kws = vars.filter_db.keys() | list -%}\n\n{%- if inf in ['',None] -%}\n  {%- set inf = vars.filter_db[\"default\"] -%}\n{%- elif inf|lower in kws -%}\n  {%- set inf = vars.filter_db[inf|lower] -%}\n{%- endif -%}\n\n{{inf}}",
                "api_loadsub": "{%- set d = vars.input.params['api_loadsub'] -%} \n{%- if d in ['',None] -%}\n1\n{%- else -%}\n{{d}}\n{%- endif -%}"
            },
            "status": null,
            "top": "120",
            "left": "360",
            "stepType": "\/api\/3\/workflow_step_types\/04d0cf46-b6a8-42c4-8683-60a7eaa69e8f",
            "group": null,
            "uuid": "7600d840-d9a9-4a80-818d-ed09d40ed59c"
        },
        {
            "@type": "WorkflowStep",
            "name": "return",
            "description": null,
            "arguments": {
                "output": "{{vars.steps.fmg_api.data}}",
                "params": "{{vars.input.params}}",
                "status": "{%- set ret = vars.status -%}\n\n{%- if not vars.connector_config -%}\n  {%- do ret.update({\n    \"error\":true,\n    \"message\":\"Connector config missing.\"\n  }) -%}\n  \n{%- elif vars.steps.fmg_api.data.status != 0 -%}\n  {%- do ret.update({\n    \"error\":true,\n    \"message\":vars.steps.fmg_api.data['get_response'].status.message\n  }) -%}\n\n{%- endif -%}\n\n{{ret}}"
            },
            "status": null,
            "top": "120",
            "left": "40",
            "stepType": "\/api\/3\/workflow_step_types\/04d0cf46-b6a8-42c4-8683-60a7eaa69e8f",
            "group": null,
            "uuid": "96530c19-09df-4a2b-b894-59fea267214f"
        },
        {
            "@type": "WorkflowStep",
            "name": "setup input vars",
            "description": "Leverage input vars from user or the overriding step.",
            "arguments": {
                "status": "{# Set a default status #}\n{%- set ret = {} -%}\n{%- do ret.update({\n  \"error\":false,\n  \"message\":\"\"\n}) -%}\n{{ret}}",
                "api_data": "{%- set apifilter = vars.api_filter -%}\n{%- set apifields = vars.api_fields -%}\n\n{%- set ret = {\n  \"option\": [\"extra info\",\"assignment info\",\"get meta\"],\n  \"loadsub\":vars.api_loadsub\n} -%}\n\n{%- if apifilter -%}\n{%- do ret.update({\"filter\":apifilter}) -%}\n{%- endif -%}\n\n{%- if apifields -%}\n{%- do ret.update({\"fields\":apifields}) -%}\n{%- endif -%}\n\n{{ret}}",
                "connector_config": "{{vars.input.params['connector_config']}}"
            },
            "status": null,
            "top": "200",
            "left": "360",
            "stepType": "\/api\/3\/workflow_step_types\/04d0cf46-b6a8-42c4-8683-60a7eaa69e8f",
            "group": null,
            "uuid": "46d1d3d5-4ae8-4d56-add9-d464755bc127"
        },
