{
    "@context": "\/api\/3\/contexts\/Workflow",
    "@type": "Workflow",
    "triggerLimit": null,
    "name": "> get fmg devices",
    "aliasName": null,
    "tag": null,
    "description": "API call for \/dvmdb\/device with options to filter and\/or select fields.",
    "isActive": true,
    "debug": false,
    "singleRecordExecution": false,
    "remoteExecutableFlag": false,
    "parameters": [
        "connector_config",
        "api_filter",
        "api_fields",
        "api_loadsub",
        "api_adom"
    ],
