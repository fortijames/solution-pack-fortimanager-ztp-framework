        },
        {
            "@type": "WorkflowStep",
            "name": "fmg_api",
            "description": null,
            "arguments": {
                "name": "Fortinet FortiManager JSON RPC",
                "config": "{{vars.connector_config}}",
                "params": {
                    "url": "{{vars.api_json_proxy}}",
                    "data": "{{vars.api_payload}}",
                    "track_task": false
                },
                "version": "1.1.0",
                "connector": "fortinet-fortimanager-json-rpc",
                "operation": "json_rpc_execute",
                "operationTitle": "JSON RPC Exec",
                "pickFromTenant": false,
                "step_variables": []
            },
            "status": null,
            "top": "200",
