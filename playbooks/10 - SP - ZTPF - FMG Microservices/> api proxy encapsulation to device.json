        },
        {
            "@type": "WorkflowStep",
            "name": "create targets",
            "description": null,
            "arguments": {
                "api_targets": "{%- set tgt = [] -%}\n\n{%- for t in vars.in_target -%}\n  {%- if \"\/\" in t -%}\n    {%- do tgt.append(t) -%}\n  {%- else -%}\n    {%- do tgt.append(\"device\/\" + t) -%}\n  {%- endif -%}\n{%- endfor -%}\n\n{{tgt}}"
            },
            "status": null,
            "top": "200",
            "left": "720",
            "stepType": "\/api\/3\/workflow_step_types\/04d0cf46-b6a8-42c4-8683-60a7eaa69e8f",
