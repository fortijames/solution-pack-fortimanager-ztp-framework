        },
        {
            "@type": "WorkflowStep",
            "name": "initial vars",
            "description": null,
            "arguments": {
                "status": "{# Set a default status #}\n{%- set ret = {} -%}\n{%- do ret.update({\n  \"error\":false,\n  \"message\":\"\"\n}) -%}\n{{ret}}",
                "in_action": "{{vars.input.params.action}}",
                "in_target": "{%- set in_field = vars.input.params.target -%}\n{%- set ret = '' -%}\n\n{%- if in_field not in ['',None] -%}\n  {%- if in_field is sequence and in_field is not string -%}\n    {% set ret = in_field %}\n  {%- else -%}\n    {%- set cmt = in_field | regex_replace('[,\\n]+', ',') -%}\n    {%- set ret = cmt.split(',') | list -%}\n  {%- endif -%}\n{%- endif -%}\n\n{{ret}}",
                "in_payload": "{{vars.input.params.payload}}",
                "in_resource": "{{vars.input.params.resource}}",
                "api_json_proxy": "\/sys\/proxy\/json",
                "connector_config": "{{vars.input.params['connector_config']}}"
            },
            "status": null,
            "top": "40",
            "left": "340",
            "stepType": "\/api\/3\/workflow_step_types\/04d0cf46-b6a8-42c4-8683-60a7eaa69e8f",
            "group": null,
            "uuid": "89144c45-ec61-412f-b9e7-db44d8fa2a1b"
        },
        {
            "@type": "WorkflowStep",
            "name": "return",
            "description": null,
            "arguments": {
                "output": "{{vars.steps.fmg_api}}",
                "params": "{{vars.input.params}}",
                "status": "{%- set s = vars.status -%}\n{%- set fmgret = vars.steps.fmg_api.data -%}\n\n{%- if fmgret.execute_response.status is defined\n      and fmgret.execute_response.status.code != 0\n-%}\n  {%- do s.update({\n    \"error\":true,\n    \"message\":fmgret.execute_response.status.message\n  }) -%}\n{%- endif -%}\n\n{{s}}"
            },
            "status": null,
