        {
            "@type": "WorkflowStep",
            "name": "create payload",
            "description": null,
            "arguments": {
                "api_payload": "{\n  \"data\": {\n    \"action\": \"{{vars.in_action}}\",\n    \"resource\": \"{{vars.in_resource}}\",\n    \"target\": {{vars.api_targets}},\n    \"payload\": {{ vars.in_payload | default({}, true)}}\n  }\n}"
            },
            "status": null,
            "top": "360",
