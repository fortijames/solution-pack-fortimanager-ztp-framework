                "status": "{%- set a = vars.steps.exec_task.data -%}\n{%- set ret = {\"error\":false,\"msg\":\"Task Created without error.\"} -%}\n{%- if a.status.error -%}\n  {%- do ret.update({\n      \"error\":true,\n      \"msg\":a.status.message\n    }\n  ) -%}\n{%- endif -%}\n{{ret}}"
