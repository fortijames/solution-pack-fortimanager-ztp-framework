            "name": "setup payload",
            "description": null,
            "arguments": {
                "api_payload": "{%- set ret = \n    {\n      \"data\": {\n        \"adom\": vars.adom,\n        \"create_task\": \"enable\",\n        \"devices\": [],\n        \"flags\": 900\n      }\n    } \n-%}\n\n{%- for d in vars.devices -%}\n  {%- set d = {\"image\":vars.firmware,\"name\":d} -%}\n  {%- do ret.data.devices.append(d) -%}\n{%- endfor -%}\n\n{{ret}}"
            },
            "status": null,
            "top": "160",
            "left": "520",
