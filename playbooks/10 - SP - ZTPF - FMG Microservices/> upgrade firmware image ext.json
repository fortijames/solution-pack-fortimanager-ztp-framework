                "track_task": "{%- set inp = vars.input.params['track_task'] -%}\n{%- if inp == False -%}\n{{inp}}\n{%- else -%}\nTrue\n{%- endif -%}",
                "connector_config": "{{vars.input.params['connector_config']}}",
