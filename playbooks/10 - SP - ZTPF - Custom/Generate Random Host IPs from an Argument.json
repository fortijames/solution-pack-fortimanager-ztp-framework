            "name": "generate random_ips",
            "description": null,
            "arguments": {
                "random_ips": "{%- set subnets = vars.networks -%}\n{%- set table = [] -%}\n{%- for i in range(vars.total_ips|int) -%}\n  {%- set subnet = subnets | random -%}\n  {%- set size = subnet | ipaddr('size_usable') -%}\n  {%- do table.append(\n    subnet \n      | ipaddr('subnet') \n      | ipsubnet('32',(size|random)) \n      | ipaddr('address')\n  ) -%}\n{%- endfor -%}\n{{table}}"
            },
