                                "display": "FMGBP",
                                "itemValue": ""
                            },
                            "operator": "eq"
                        }
                    ],
                    "__selectFields": [
                        "id",
                        "name",
                        "platform"
                    ]
                },
                "module": "ztpf_devices?$limit=5000",
                "checkboxFields": true,
                "step_variables": {
                    "device_list": "{%- set table = [] -%}\n{%- for d in vars.steps.find_devices -%}\n  {%- set rec = d -%}\n  {%- do rec.update(\n    {\"pick_option\":d.name + \" (\" + d.platform + \")\"}\n  )-%}\n  {%- do table.append(rec) -%}\n{%- endfor -%}\n{{table}}"
                }
            },
            "status": null,
