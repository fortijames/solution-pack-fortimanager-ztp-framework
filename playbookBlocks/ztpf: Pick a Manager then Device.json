{
    "@context": "\/api\/3\/contexts\/WorkflowGroup",
    "@type": "WorkflowGroup",
    "name": "ztpf: Pick a Manager then Device",
    "description": "<p>In the ZTPF Solution Pack, pick a Manager record and then Pick a Device from that Manager<\/p>",
    "type": "custom",
    "isCollapsed": false,
    "hasTriggerStep": false,
    "hideInLogs": false,
    "workflowSteps": [
        {
            "@type": "WorkflowStep",
            "name": "find devices",
            "description": null,
            "arguments": {
                "query": {
                    "sort": [
                        {
                            "field": "name",
                            "direction": "ASC",
                            "_fieldName": "name",
                            "_fieldTitle": "Name"
                        }
                    ],
                    "limit": 30,
                    "logic": "AND",
                    "filters": [
                        {
                            "type": "object",
                            "field": "ztpfManagers",
                            "value": "{{vars.steps.Pick_Manager.input.manager['@id']}}",
                            "_value": {
                                "@id": "{{vars.steps.Pick_Manager.input.manager['@id']}}",
                                "display": "FMGBP",
                                "itemValue": ""
                            },
                            "operator": "eq"
                        }
                    ],
                    "__selectFields": [
                        "id",
                        "name",
                        "platform"
                    ]
                },
                "module": "ztpf_devices?$limit=5000",
                "checkboxFields": true,
                "step_variables": {
                    "device_list": "{%- set table = [] -%}\n{%- for d in vars.steps.find_devices -%}\n  {%- if d.name and d.platform -%}\n    {%- set rec = d -%}\n    {%- do rec.update(\n      {\"pick_option\":d.name + \" (\" + d.platform + \")\"}\n    )-%}\n    {%- do table.append(rec) -%}\n  {%- endif -%}\n{%- endfor -%}\n{{table}}"
                }
            },
            "status": null,
            "top": "51",
            "left": "348",
            "stepType": "\/api\/3\/workflow_step_types\/b593663d-7d13-40ce-a3a3-96dece928770",
