            "name": "create device options",
            "description": null,
            "arguments": {
                "manager_and_device_options": "{%- set recs = vars.steps.find_devices_with_manager -%}\n{%- set src = [] -%}\n{%- set mdb = [] -%}\n\n{%- for s in recs -%}\n  {%- set n = s -%}\n  {%- set m = s.ztpfManagers.name\n                  + \" (\"\n                  + s.ztpfManagers.firmware.split(' ')[0]\n                  + \")\"\n  -%}\n  {%- set d = s.name\n                  + \" (\"\n                  + s.platform\n                  + \")\"\n  -%}\n  {%- do n.update({\n    \"_option_mgr\":m,\n    \"_option_dev\":d\n  }) -%}\n  {%- do src.append(n) -%}\n{%- endfor -%}\n\n{%- set managers = src|json_query('[]._option_mgr')|unique -%}\n{%- for m in managers|sort  -%}\n  {%- set o = {} -%}\n  {%- do o.update({\n    \"value\":m,\n    \"options\": src \n        | json_query('[?_option_mgr==`{}`]'.format(m))\n        | json_query('[]._option_dev') | sort\n  }) -%}\n  {%- do mdb.append(o) -%}\n{%- endfor -%}\n\n{\n\"opts\": {{mdb}},\n \"src\": {{src}}\n}"
            },
            "status": null,
            "top": "136",
            "left": "263",
            "stepType": "\/api\/3\/workflow_step_types\/04d0cf46-b6a8-42c4-8683-60a7eaa69e8f",
